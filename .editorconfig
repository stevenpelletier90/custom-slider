# Editor-level basics, mirrored from .prettierrc.json and .gitattributes so
# any editor (and the EditorConfig extension in VS Code) agrees with Prettier
# before Prettier runs.
root = true

[*]
indent_style = space
indent_size = 2
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

# Markdown uses two trailing spaces for a hard line break.
[*.md]
trim_trailing_whitespace = false
