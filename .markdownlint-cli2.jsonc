// markdownlint-cli2 config — see https://github.com/DavidAnson/markdownlint-cli2
{
  "globs": ["**/*.md"],
  // .claude/worktrees/ holds a full checkout per isolated agent session; it is
  // gitignored (so Prettier skips it) but cli2 does not read .gitignore.
  "ignores": ["node_modules", ".superpowers", ".playwright-mcp", ".claude/worktrees"],
  "config": {
    "default": true,
    "MD013": false,
    "MD024": { "siblings_only": true },
    "MD033": false,
    "MD036": false,
    "MD041": false,
  },
}
