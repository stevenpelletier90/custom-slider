{
  "name": "custom-slider",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild src/auto.js --bundle --format=iife --minify --outfile=dist/dl-carousel.js && esbuild src/dl-carousel.css --minify --outfile=dist/dl-carousel.css",
